{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext"],
    "module": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["skills/**/*.ts", "tests/**/*.ts", "evals/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
