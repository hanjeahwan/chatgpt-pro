{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    ".agents/skills/plan-spec-implementation/scripts/**/*.ts",
    "skills/**/*.ts",
    "tests/**/*.ts",
    "evals/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
